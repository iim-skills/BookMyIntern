# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/job-portal?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_SECRET=replace-with-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# Admin signup secret key — anyone who knows this can create an admin account
ADMIN_SIGNUP_KEY=choose-a-secret-only-you-know

# Email verification (optional — leave blank to skip)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=BookMyIntern <your@gmail.com>
